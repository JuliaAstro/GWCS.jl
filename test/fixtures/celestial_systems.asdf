wcs:
  fk4_1975: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/identity-1.4.0
        inputs: [x0, x1]
        n_dims: 2
        outputs: [x0, x1]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: world
        reference_frame: !<tag:astropy.org:astropy/coordinates/frames/fk4-1.2.0>
          frame_attributes:
            equinox: &id001 !time/time-1.4.0 {scale: tt, value: B1975.000}
            obstime: *id001
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
