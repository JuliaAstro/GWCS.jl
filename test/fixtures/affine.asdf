#ASDF 1.0.0
#ASDF_STANDARD 1.6.0
%YAML 1.1
%TAG ! tag:stsci.edu:asdf/
--- !core/asdf-1.1.0
asdf_library: !core/software-1.0.0
  author: The ASDF Developers
  homepage: http://github.com/asdf-format/asdf
  name: asdf
  version: 5.3.1
history:
  extensions:
    - !core/extension_metadata-1.0.0
      extension_class: asdf.extension._manifest.ManifestExtension
      extension_uri: asdf://asdf-format.org/core/extensions/core-1.6.0
      manifest_software: !core/software-1.0.0
        name: asdf_standard
        version: 1.5.0
      software: !core/software-1.0.0
        name: asdf
        version: 5.3.1
    - !core/extension_metadata-1.0.0
      extension_class: asdf.extension._manifest.ManifestExtension
      extension_uri: asdf://asdf-format.org/transform/extensions/transform-1.7.0
      manifest_software: !core/software-1.0.0
        name: asdf_transform_schemas
        version: 0.6.0
      software: !core/software-1.0.0
        name: asdf-astropy
        version: 0.11.0
transform: !transform/affine-1.5.0
  inputs: [x, y]
  matrix: !core/ndarray-1.1.0
    data:
      - [1.0, 0.2]
      - [-0.1, 2.0]
    datatype: float64
    shape: [2, 2]
  outputs: [x, y]
  translation: !core/ndarray-1.1.0
    data: [3.0, 4.0]
    datatype: float64
    shape: [2]
...
