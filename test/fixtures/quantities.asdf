#ASDF 1.0.0
#ASDF_STANDARD 1.6.0
%YAML 1.1
%TAG ! tag:stsci.edu:asdf/
--- !core/asdf-1.1.0
asdf_library: !core/software-1.0.0 {author: The ASDF Developers, homepage: 'http://github.com/asdf-format/asdf',
  name: asdf, version: 5.3.1}
history:
  extensions:
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/core/extensions/core-1.6.0
    manifest_software: !core/software-1.0.0 {name: asdf_standard, version: 1.5.0}
    software: !core/software-1.0.0 {name: asdf, version: 5.3.1}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/extensions/astronomy-1.2.0
    manifest_software: !core/software-1.0.0 {name: asdf_standard, version: 1.5.0}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://astropy.org/astropy/extensions/units-1.3.0
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/gwcs/extensions/gwcs-1.4.0
    manifest_software: !core/software-1.0.0 {name: asdf_wcs_schemas, version: 0.5.0}
    software: !core/software-1.0.0 {name: gwcs, version: 1.0.3}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/transform/extensions/transform-1.7.0
    manifest_software: !core/software-1.0.0 {name: asdf_transform_schemas, version: 0.6.0}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/coordinates/extensions/coordinates-1.0.0
    manifest_software: !core/software-1.0.0 {name: asdf_coordinates_schemas, version: 0.5.1}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
  - !core/extension_metadata-1.0.0
    extension_class: asdf.extension._manifest.ManifestExtension
    extension_uri: asdf://asdf-format.org/astronomy/coordinates/extensions/coordinates-1.3.0
    manifest_software: !core/software-1.0.0 {name: asdf_coordinates_schemas, version: 0.5.1}
    software: !core/software-1.0.0 {name: asdf-astropy, version: 0.11.0}
transform_inputs:
  airy: !core/ndarray-1.1.0
    data:
    - [1.0, 2.0]
    - [-3.0, 0.5]
    datatype: float64
    shape: [2, 2]
  euler: !core/ndarray-1.1.0
    data:
    - [10.0, 20.0]
    - [-30.0, 40.0]
    datatype: float64
    shape: [2, 2]
  rotation: !core/ndarray-1.1.0
    data:
    - [1.5, -2.0]
    datatype: float64
    shape: [1, 2]
  sin: !core/ndarray-1.1.0
    data:
    - [1.0, 2.0]
    - [-3.0, 0.5]
    datatype: float64
    shape: [2, 2]
  szp: !core/ndarray-1.1.0
    data:
    - [1.0, 2.0]
    - [-3.0, 0.5]
    datatype: float64
    shape: [2, 2]
transform_outputs:
  airy: !core/ndarray-1.1.0
    data:
    - [153.43494882292202, 87.72502259145625]
    - [-99.46232220802563, 86.90577809875953]
    datatype: float64
    shape: [2, 2]
  euler: !core/ndarray-1.1.0
    data:
    - [10.534194680895547, 17.305201950455036]
    - [-18.371603167769223, 49.20235596118723]
    datatype: float64
    shape: [2, 2]
  rotation: !core/ndarray-1.1.0
    data:
    - [1.5260506825036995, -1.9801942617909973]
    datatype: float64
    shape: [1, 2]
  sin: !core/ndarray-1.1.0
    data:
    - [153.55999685299653, 87.76335868244918]
    - [-99.51250052799497, 86.94849384990393]
    datatype: float64
    shape: [2, 2]
  szp: !core/ndarray-1.1.0
    data:
    - [153.37952796918688, 87.77179328341064]
    - [-99.19709640031934, 86.96001472367705]
    datatype: float64
    shape: [2, 2]
transforms:
  airy: !transform/airy-1.4.0
    direction: pix2sky
    inputs: [x, y]
    outputs: [phi, theta]
    theta_b: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
      value: 60.0}
  euler: !transform/rotate3d-1.5.0
    direction: zxz
    inputs: [alpha, delta]
    outputs: [alpha, delta]
    phi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 rad, value: 0.1}
    psi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 arcmin, value: 30.000000000000004}
    theta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 20.0}
  rotation: !transform/rotate2d-1.5.0
    angle: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 arcsec,
      value: 2700.0}
    inputs: [x, y]
    outputs: [x, y]
  sin: !transform/slant_orthographic-1.4.0
    direction: pix2sky
    eta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 '', value: -0.05}
    inputs: [x, y]
    outputs: [phi, theta]
    xi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 '', value: 0.1}
  szp: !transform/slant_zenithal_perspective-1.4.0
    direction: pix2sky
    inputs: [x, y]
    mu: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 '', value: 0.5}
    outputs: [phi, theta]
    phi0: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 170.0}
    theta0: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 59.99999999999999}
wcs:
  fiducial: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/gnomonic-1.4.0
          direction: pix2sky
          inputs: [x, y]
          outputs: [phi, theta]
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 29.999999999999996}
          psi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 180.0}
          theta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 45.0}
        inputs: [x, y]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: CelestialFrame
        reference_frame: !<tag:astropy.org:astropy/coordinates/frames/icrs-1.1.0>
          data: !<tag:astropy.org:astropy/coordinates/representation-1.2.0>
            components:
              lat: !<tag:astropy.org:astropy/coordinates/latitude-1.2.0> {datatype: float64,
                unit: !unit/unit-1.0.0 deg, value: 45.0}
              lon: !<tag:astropy.org:astropy/coordinates/longitude-1.2.0>
                datatype: float64
                unit: !unit/unit-1.0.0 deg
                value: 30.0
                wrap_angle: !<tag:astropy.org:astropy/coordinates/angle-1.2.0> {datatype: float64,
                  unit: !unit/unit-1.0.0 deg, value: 360.0}
            type: UnitSphericalRepresentation
          frame_attributes: {}
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
  galactic: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/compose-1.4.0
          forward:
          - !transform/concatenate-1.4.0
            forward:
            - !transform/scale-1.4.0
              factor: 0.001
              inputs: [x]
              outputs: [y]
            - !transform/scale-1.4.0
              factor: 0.001
              inputs: [x]
              outputs: [y]
            inputs: [x0, x1]
            outputs: [y0, y1]
          - !transform/gnomonic-1.4.0
            direction: pix2sky
            inputs: [x, y]
            outputs: [phi, theta]
          inputs: [x0, x1]
          outputs: [phi, theta]
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: 29.999999999999996
          psi: 180.0
          theta: 45.0
        inputs: [x0, x1]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.galactic.lon, pos.galactic.lat]
        name: world
        reference_frame: !<tag:astropy.org:astropy/coordinates/frames/galactic-1.2.0>
          frame_attributes: {}
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
  mixed: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/compose-1.4.0
          forward:
          - !transform/compose-1.4.0
            forward:
            - !transform/compose-1.4.0
              forward:
              - !transform/concatenate-1.4.0
                forward:
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -10.0
                  outputs: [y]
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -20.0
                  outputs: [y]
                inputs: [x0, x1]
                outputs: [y0, y1]
              - !transform/rotate2d-1.5.0
                angle: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 rad,
                  value: 0.3}
                inputs: [x, y]
                outputs: [x, y]
              inputs: [x0, x1]
              outputs: [x, y]
            - !transform/concatenate-1.4.0
              forward:
              - !transform/scale-1.4.0
                factor: 0.001
                inputs: [x]
                outputs: [y]
              - !transform/scale-1.4.0
                factor: 0.001
                inputs: [x]
                outputs: [y]
              inputs: [x0, x1]
              outputs: [y0, y1]
            inputs: [x0, x1]
            outputs: [y0, y1]
          - !transform/zenithal_perspective-1.5.0
            direction: pix2sky
            gamma: 29.999999999999996
            inputs: [x, y]
            mu: 2.0
            outputs: [phi, theta]
          inputs: [x0, x1]
          outputs: [phi, theta]
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 arcmin,
            value: 1800.0}
          psi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 rad,
            value: 3.141592653589793}
          theta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 45.0}
        inputs: [x0, x1]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: world
        reference_frame: !<tag:astropy.org:astropy/coordinates/frames/icrs-1.1.0>
          frame_attributes: {}
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
  plain: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/compose-1.4.0
          forward:
          - !transform/compose-1.4.0
            forward:
            - !transform/compose-1.4.0
              forward:
              - !transform/concatenate-1.4.0
                forward:
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -10.0
                  outputs: [y]
                - !transform/shift-1.4.0
                  inputs: [x]
                  offset: -20.0
                  outputs: [y]
                inputs: [x0, x1]
                outputs: [y0, y1]
              - !transform/rotate2d-1.5.0
                angle: 17.188733853924695
                inputs: [x, y]
                outputs: [x, y]
              inputs: [x0, x1]
              outputs: [x, y]
            - !transform/concatenate-1.4.0
              forward:
              - !transform/scale-1.4.0
                factor: 0.001
                inputs: [x]
                outputs: [y]
              - !transform/scale-1.4.0
                factor: 0.001
                inputs: [x]
                outputs: [y]
              inputs: [x0, x1]
              outputs: [y0, y1]
            inputs: [x0, x1]
            outputs: [y0, y1]
          - !transform/zenithal_perspective-1.5.0
            direction: pix2sky
            gamma: 29.999999999999996
            inputs: [x, y]
            mu: 2.0
            outputs: [phi, theta]
          inputs: [x0, x1]
          outputs: [phi, theta]
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: 29.999999999999996
          psi: 180.0
          theta: 45.0
        inputs: [x0, x1]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: world
        reference_frame: !<tag:astropy.org:astropy/coordinates/frames/icrs-1.1.0>
          frame_attributes: {}
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
wcs_inputs:
  fiducial: !core/ndarray-1.1.0
    data:
    - [0.0, 0.0]
    - [0.01, -0.02]
    datatype: float64
    shape: [2, 2]
  galactic: !core/ndarray-1.1.0
    data:
    - [10.0, -20.0]
    datatype: float64
    shape: [1, 2]
  mixed: &id001 !core/ndarray-1.1.0
    data:
    - [100.0, 200.0]
    - [-50.0, 30.0]
    datatype: float64
    shape: [2, 2]
  plain: *id001
wcs_outputs:
  fiducial: !core/ndarray-1.1.0
    data:
    - [29.999999999999993, 45.00000000000001]
    - [30.014137200522796, 44.97999912875686]
    datatype: float64
    shape: [2, 2]
  galactic: !core/ndarray-1.1.0
    data:
    - [30.014137200522796, 44.97999912875686]
    datatype: float64
    shape: [1, 2]
  mixed: !core/ndarray-1.1.0
    data:
    - [30.046480104795123, 45.17184707245243]
    - [29.914766262995066, 44.99288590658122]
    datatype: float64
    shape: [2, 2]
  plain: !core/ndarray-1.1.0
    data:
    - [30.046480104795123, 45.17184707245243]
    - [29.914766262995066, 44.99288590658122]
    datatype: float64
    shape: [2, 2]
...
