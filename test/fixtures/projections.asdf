    outputs: [phi, theta]
  ait_sky2pix: !transform/hammer_aitoff-1.4.0
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
  bon_pix2sky: !transform/bonne_equal_area-1.5.0
    direction: pix2sky
    inputs: [x, y]
    outputs: [phi, theta]
    theta1: 29.999999999999996
  bon_sky2pix: !transform/bonne_equal_area-1.5.0
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
    theta1: 29.999999999999996
