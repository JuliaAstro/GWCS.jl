  car_sky2pix: !transform/plate_carree-1.4.0
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
  cea_pix2sky: !transform/cylindrical_equal_area-1.5.0
    direction: pix2sky
    inputs: [x, y]
    lam: 0.7
    outputs: [phi, theta]
  cea_sky2pix: !transform/cylindrical_equal_area-1.5.0
    direction: sky2pix
    inputs: [phi, theta]
    lam: 0.7
    outputs: [x, y]
  cod_pix2sky: !transform/conic_equidistant-1.5.0
    delta: 14.999999999999998
    direction: pix2sky
    inputs: [x, y]
    outputs: [phi, theta]
    sigma: -29.999999999999996
  cod_sky2pix: !transform/conic_equidistant-1.5.0
    delta: 14.999999999999998
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
    sigma: -29.999999999999996
  coe_pix2sky: !transform/conic_equal_area-1.5.0
    delta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 10.0}
    direction: pix2sky
    inputs: [x, y]
    outputs: [phi, theta]
    sigma: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 45.0}
  coe_sky2pix: !transform/conic_equal_area-1.5.0
    delta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 10.0}
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
    sigma: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg, value: 45.0}
  coo_pix2sky: !transform/conic_orthomorphic-1.5.0
