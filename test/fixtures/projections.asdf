    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
    sigma: 45.0
  cop_pix2sky: !transform/conic_perspective-1.5.0
    delta: 10.0
    direction: pix2sky
    inputs: [x, y]
    outputs: [phi, theta]
    sigma: 45.0
  cop_sky2pix: !transform/conic_perspective-1.5.0
    delta: 10.0
    direction: sky2pix
    inputs: [phi, theta]
    outputs: [x, y]
    sigma: 45.0
  csc_pix2sky: !transform/cobe_quad_spherical_cube-1.4.0
