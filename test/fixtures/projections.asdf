wcs:
  bon: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/bonne_equal_area-1.5.0
          direction: pix2sky
          inputs: [x, y]
          outputs: [phi, theta]
          theta1: 29.999999999999996
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 29.999999999999996}
          psi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 0.0}
          theta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 45.0}
        inputs: [x, y]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: CelestialFrame
        reference_frame: &id003 !<tag:astropy.org:astropy/coordinates/frames/icrs-1.1.0>
          data: !<tag:astropy.org:astropy/coordinates/representation-1.2.0>
            components:
              lat: !<tag:astropy.org:astropy/coordinates/latitude-1.2.0> {datatype: float64,
                unit: !unit/unit-1.0.0 deg, value: 45.0}
              lon: !<tag:astropy.org:astropy/coordinates/longitude-1.2.0>
                datatype: float64
                unit: !unit/unit-1.0.0 deg
                value: 30.0
                wrap_angle: !<tag:astropy.org:astropy/coordinates/angle-1.2.0> {datatype: float64,
                  unit: !unit/unit-1.0.0 deg, value: 360.0}
            type: UnitSphericalRepresentation
          frame_attributes: {}
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
  car: !<tag:stsci.edu:gwcs/wcs-1.4.0>
    name: ''
    pixel_shape: null
    steps:
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: detector
      transform: !transform/compose-1.4.0
        forward:
        - !transform/plate_carree-1.4.0
          direction: pix2sky
          inputs: [x, y]
          outputs: [phi, theta]
        - !transform/rotate3d-1.5.0
          direction: native2celestial
          inputs: [phi_N, theta_N]
          outputs: [alpha_C, delta_C]
          phi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 29.999999999999996}
          psi: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 0.0}
          theta: !unit/quantity-1.3.0 {datatype: float64, unit: !unit/unit-1.0.0 deg,
            value: 45.0}
        inputs: [x, y]
        outputs: [alpha_C, delta_C]
    - !<tag:stsci.edu:gwcs/step-1.3.0>
      frame: !<tag:stsci.edu:gwcs/celestial_frame-1.2.0>
        axes_names: [lon, lat]
        axes_order: [0, 1]
        axis_physical_types: [pos.eq.ra, pos.eq.dec]
        name: CelestialFrame
        reference_frame: *id003
        unit: [!unit/unit-1.0.0 deg, !unit/unit-1.0.0 deg]
      transform: null
wcs_inputs:
  bon: !core/ndarray-1.1.0
    data:
    - [0.0, 0.0]
    - [1.5, -2.0]
    datatype: float64
    shape: [2, 2]
  car: !core/ndarray-1.1.0
    data:
    - [0.0, 0.0]
    - [1.5, -2.0]
    datatype: float64
    shape: [2, 2]
wcs_outputs:
  bon: !core/ndarray-1.1.0
    data:
    - [210.0, 45.0]
    - [212.05031952622534, 42.97243833009103]
    datatype: float64
    shape: [2, 2]
  car: !core/ndarray-1.1.0
    data:
    - [210.0, 45.0]
    - [212.04931214858766, 42.98103158872089]
    datatype: float64
    shape: [2, 2]
...
